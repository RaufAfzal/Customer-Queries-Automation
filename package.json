  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "install-client": "npm install --prefix client-side",
    "install-server": "npm install --prefix server-side",
    "install": "npm run install-client && npm run install-server",
    "build-client": "npm run build --prefix client-side",
    "build": "npm run build --prefix client-side",
    "start-server": "node server-side/server.js",
    "start": "npm run build && npm run start-server",
    "dev": "concurrently \"npm start --prefix server-side\" \"npm start --prefix client-side\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
